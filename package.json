{
  "name": "mail-automation-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "database"
  ],
  "scripts": {
    "dev": "concurrently -n frontend,backend -c cyan,magenta \"npm --prefix frontend run dev\" \"npm --prefix backend run dev\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "lint": "npm --prefix frontend run lint && npm --prefix backend run lint",
    "build": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "typecheck": "npm --prefix frontend run typecheck && npm --prefix backend run typecheck",
    "test": "npm --prefix frontend run test",
    "test:e2e": "playwright test",
    "start:daemon": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-service-background.ps1",
    "stop:daemon": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/stop-service-background.ps1",
    "status:daemon": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/status-service-background.ps1",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:status": "pm2 status"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "concurrently": "^10.0.6"
  }
}
