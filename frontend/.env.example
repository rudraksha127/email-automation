# Frontend (Vercel) Environment Variables

# URL of your Render backend. In production on Vercel, configure this
# so Next.js proxies every /api/* request (including auth) to your Express backend:
BACKEND_API_URL=https://your-backend.onrender.com

# Optional: Set to "true" ONLY to run UI in demo/mock mode without calling real backend
# NEXT_PUBLIC_USE_MOCK_API=true
