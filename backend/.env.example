# ==============================================================================
# Render Backend Service Environment Variables (Express API)
# ==============================================================================
# Set these in the Render Dashboard -> Environment -> Environment Variables.
# NEVER commit real values or secrets to git.

# ---- Runtime ----
NODE_ENV=production
# Render automatically injects PORT at runtime (e.g. 10000)
PORT=3000

# ---- CORS Settings ----
# Allow requests from your Vercel frontend URL (comma-separated for previews)
# Example: https://mail-automation.vercel.app,https://mail-automation-*.vercel.app
CORS_ORIGIN=http://localhost:3000
# Destination for post-OAuth redirect
FRONTEND_URL=http://localhost:3000

# ---- Database (Supabase PostgreSQL / SQLite fallback) ----
# Primary: Supabase connection
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Fallback: Local/persistent disk SQLite path (when running standalone or during migration)
# In Render, point to persistent disk mount: /disks/pilot/data/pilot.db
PILOT_DB_PATH=./data/pilot.db

# ---- Gmail OAuth (Google Cloud Console OAuth 2.0 Credentials) ----
# Create in Google Cloud Console -> APIs & Services -> Credentials
GMAIL_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-client-secret
# Production: https://<your-render-backend-name>.onrender.com/api/gmail/callback
# Local: http://localhost:3001/api/gmail/callback
GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# ---- Encryption Key for Stored Tokens (REQUIRED in Production) ----
# Generate via: openssl rand -hex 32
GMAIL_TOKEN_KEY=your-32-byte-hex-encryption-key

# ---- Default Administrator Account (Seeded on first boot) ----
# Boot fails fast in production if these are missing.
PILOT_ADMIN_EMAIL=admin@institution.edu
PILOT_ADMIN_PASSWORD=change-me-on-first-login

# ---- Pilot Bootstrap Seeds (Optional seeds for default workspace) ----
# Target monitored mailbox
GMAIL_TARGET_EMAIL=target-mailbox@institution.edu
# Comma-separated sender allowlist (empty = fail closed: holds everything for review)
PILOT_ALLOWED_SENDERS=hod@institution.edu,faculty@institution.edu
# Comma-separated recipients for pilot batches
PILOT_BATCH_2027_RECIPIENTS=student1@institution.edu,student2@institution.edu
PILOT_BATCH_2028_RECIPIENTS=student3@institution.edu,student4@institution.edu
# CC address applied to forwarded emails
PILOT_CC_EMAIL=it-records@institution.edu

# ---- Poller Worker Settings ----
# Background Gmail polling interval in milliseconds (default: 60000 = 60s, min: 15000)
PILOT_SYNC_INTERVAL_MS=60000
# Set to "true" to disable background polling worker during tests
# PILOT_DISABLE_POLLER=true
