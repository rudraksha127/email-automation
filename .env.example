# Mail Automation Platform — environment template (multi-tenant).
# Copy to `.env.local` (gitignored) for local dev, or set these in the hosting
# provider's environment configuration for production. NEVER commit real values.
#
# Rule: every value below is a PLACEHOLDER in this file. Real addresses and
# credentials belong only in .env.local / provider env config.

# ---- Runtime ----
NODE_ENV=development
# Port is assigned by the host (Render sets PORT automatically).
#PORT=3000

# ---- Gmail OAuth (application-level client, server-side ONLY) ----
# The OAuth Client ID/Secret identify the APPLICATION, not a mailbox.
# Every workspace connects its own Gmail account through this one client.
# Authorized redirect URI (dev): http://localhost:3000/api/gmail/callback
# Production URI must be:       https://<your-backend-host>/api/gmail/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# ---- OAuth token encryption (REQUIRED in production) ----
# Encrypts refresh/access tokens at rest (AES-256-GCM).
# Generate: openssl rand -hex 32
# Production refuses to store tokens without this; dev auto-generates a local
# key file under ./data (gitignored) when unset.
GMAIL_TOKEN_KEY=

# ---- Workspaces ----
# Name of the default workspace created on first boot:
DEFAULT_ORG_NAME=Main Workspace

# ---- First-boot bootstrap for the DEFAULT workspace (all optional) ----
# After first boot, everything below is managed from the UI (Settings, Groups,
# Members) — these values are ONLY seeds and never overwrite existing rows.
# Target mailbox used by the legacy single-mailbox mock UI (optional):
#GMAIL_TARGET_EMAIL=target-mailbox@your-domain.example
# Sender allowlist seed (comma-separated; empty = fail closed: everything held
# for review until configured in Settings):
PILOT_ALLOWED_SENDERS=
# Group recipient seeds (comma-separated):
PILOT_BATCH_2027_RECIPIENTS=
PILOT_BATCH_2028_RECIPIENTS=
# CC applied to every forward (empty = forwarding disabled until configured):
PILOT_CC_EMAIL=

# ---- Default-workspace admin (seeded on first boot) ----
# REQUIRED in production — boot fails fast if missing.
# Change the password in Settings after first login. Additional users register
# at /register and get NO privileges until they create or join a workspace.
PILOT_ADMIN_EMAIL=
PILOT_ADMIN_PASSWORD=

# ---- Optional ----
# SQLite file location (default: ./data/pilot.db) — point at a persistent disk
#PILOT_DB_PATH=./data/pilot.db
# Background Gmail poll interval in ms (default 60000, min 15000)
#PILOT_SYNC_INTERVAL_MS=60000
# Disable the background poller (e.g., during tests)
#PILOT_DISABLE_POLLER=true

# Set to "true" ONLY to run the UI against the isolated mock services (tests/demo).
# Leave unset in pilot mode — real API is the default.
#NEXT_PUBLIC_USE_MOCK_API=true
