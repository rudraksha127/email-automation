# Mail Automation PWA — environment template.
# Copy to `.env.local` (gitignored) for local dev, or set these in the hosting
# provider's environment configuration for production. NEVER commit real values.
#
# Rule: every value below is a PLACEHOLDER in this file. Real pilot addresses
# and credentials belong only in .env.local / provider env config.

# ---- Runtime ----
NODE_ENV=development
# Port is assigned by the host (Render sets PORT automatically).
#PORT=3000

# ---- Gmail OAuth (server-side ONLY — never expose via NEXT_PUBLIC_) ----
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Authorized redirect URI (dev): http://localhost:3000/api/gmail/callback
# Production URI must be:       https://<your-backend-host>/api/gmail/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# ---- Pilot data (comma-separated; placeholders shown) ----
# Target mailbox the pilot monitors (must match the OAuth'd account):
GMAIL_TARGET_EMAIL=target-mailbox@your-domain.example
# Senders allowed for auto-forwarding. EMPTY = fail closed (all held for review):
PILOT_ALLOWED_SENDERS=sender1@example.com,sender2@example.com
# Approved recipients per batch. EMPTY = batches seeded with no recipients
# (forwarding then routes to Needs Review until configured in the PWA):
PILOT_BATCH_2027_RECIPIENTS=student1@example.com,student2@example.com,student3@example.com
PILOT_BATCH_2028_RECIPIENTS=student4@example.com,student5@example.com,student6@example.com,student7@example.com
# Department CC applied to every forward. EMPTY = forwarding disabled (fail closed):
PILOT_CC_EMAIL=it-dept@your-domain.example

# ---- Pilot admin (seeded on first boot) ----
# REQUIRED in production — boot fails fast if missing.
# Change the password in Settings after first login.
PILOT_ADMIN_EMAIL=admin@your-domain.example
PILOT_ADMIN_PASSWORD=

# ---- Optional ----
# SQLite file location (default: ./data/pilot.db)
#PILOT_DB_PATH=./data/pilot.db
# Background Gmail poll interval in ms (default 60000, min 15000)
#PILOT_SYNC_INTERVAL_MS=60000
# Disable the background poller (e.g. during tests)
#PILOT_DISABLE_POLLER=true

# Set to "true" ONLY to run the UI against the isolated mock services (tests/demo).
# Leave unset in pilot mode — real API is the default.
#NEXT_PUBLIC_USE_MOCK_API=true
