# Supabase Environment Configuration
# Find these in your Supabase Dashboard -> Project Settings -> API / Database
# NEVER commit real credentials to git.

# Project URL (HTTPS)
SUPABASE_URL=

# Public Anonymous Key (used for client-side direct reads if applicable)
SUPABASE_ANON_KEY=

# Service Role Secret Key (HIGH PRIVILEGE: used by Render Backend Express server, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# Direct PostgreSQL Connection String (Pooler or Direct for migrations)
DATABASE_URL=
DIRECT_URL=
