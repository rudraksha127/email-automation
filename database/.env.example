# Supabase Environment Configuration
# Find these in your Supabase Dashboard -> Project Settings -> API / Database

# Project URL (HTTPS)
SUPABASE_URL=https://your-project-ref.supabase.co

# Public Anonymous Key (used for client-side direct reads if applicable)
SUPABASE_ANON_KEY=your-supabase-anon-key

# Service Role Secret Key (HIGH PRIVILEGE: used by Render Backend Express server, bypasses RLS)
# NEVER commit or expose to frontend bundles!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL Connection String (Pooler or Direct for migrations)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres
